{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "poligoni-web-critique",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@poligoni/web", "exec", "next", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "poligoni-mobile-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "poligoni-italia-app", "exec", "vite", "preview", "--port", "4173"],
      "port": 4173,
      "autoPort": true
    }
  ]
}
