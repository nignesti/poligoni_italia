{
  "name": "@poligoni/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema Drizzle, migrazioni e query. Piano_Sviluppo_App.md §4 e §9.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/ranges": "./src/schema/ranges.ts",
    "./schema/users": "./src/schema/users.ts",
    "./schema/bookings": "./src/schema/bookings.ts",
    "./schema/sessions": "./src/schema/sessions.ts",
    "./schema/ammo": "./src/schema/ammo.ts",
    "./schema/billing": "./src/schema/billing.ts",
    "./schema/premium": "./src/schema/premium.ts",
    "./client": "./src/client.ts",
    "./queries/ranges": "./src/queries/ranges.ts",
    "./queries/admin-ranges": "./src/queries/admin-ranges.ts",
    "./queries/admin-users": "./src/queries/admin-users.ts",
    "./queries/billing": "./src/queries/billing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:drop": "drizzle-kit drop",
    "db:geocode": "tsx scripts/geocode-census.ts",
    "db:seed": "tsx scripts/run-seed.ts",
    "db:seed:hours": "tsx scripts/run-seed-hours.ts",
    "db:seed:billing-plans": "tsx scripts/run-seed-billing-plans.ts"
  },
  "dependencies": {
    "@poligoni/core": "workspace:*",
    "@poligoni/schemas": "workspace:*",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "^0.43.1",
    "postgres": "^3.4.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
